# --- Core Django Configuration ---
DEBUG=True
SECRET_KEY=replace-me-with-a-cryptographically-random-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,backend
ENABLE_STUDY_TELEMETRY=True

# --- Database (PostgreSQL 17 in Docker/Prod; omit locally to default to SQLite) ---
POSTGRES_DB=opsdesk
POSTGRES_USER=opsdesk
POSTGRES_PASSWORD=opsdesk_dev_password
DATABASE_URL=postgres://opsdesk:opsdesk_dev_password@db:5432/opsdesk

# --- Origins & TLS Hardening (Active when DEBUG=False) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# --- Runtime Tuning (Gunicorn W = 2C + 1) ---
GUNICORN_WORKERS=3
SEED_DEMO=true
